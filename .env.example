OCTO_API_KEY=YOUR_API_KEY # Your API key from https://octopus.energy/login/?next=/dashboard/developer/
OCTO_ACCOUNT_NUMBER=A-12345678 # Account used to discover import/export meters and historical tariffs
OCTO_ELECTRIC_ENABLED=true # Set false for export-only or gas-only collection
# OCTO_ELECTRIC_SN=SN1234567890 # Optional filter if discovery finds multiple meters
# OCTO_ELECTRIC_MPAN=1234567890123 # Optional import MPAN filter
INFLUXDB_URL=http://localhost:8086 # Full URL to your InfluxDB server
INFLUXDB_TOKEN=YOUR_WRITE_TOKEN # A token with write access to your bucket
INFLUXDB_ORG=YOUR_ORGANIZATION # Your InfluxDB organization
INFLUXDB_BUCKET=octopus-data # the bucket name for your metrics to be stored in, this must exist first
LOOP_TIME=600 #How often to poll the Octopus API in seconds
PAGE_SIZE=48 # 48 is 24 hours of data, useful if you want to pull a large backload of data in for historical reasons, realistically this can be set to 48 (1 point every 30 mins in a 24 hour window) - maximum sizes are in the Octopus API docs

# Optional legacy gas support: uncomment and configure all six settings to enable.
# Covered by mocked regression tests, not live-tested by the current maintainer.
# Verify the meter's units and conversion factors before enabling.
# OCTO_GAS_MPRN=YOUR_MPRN
# OCTO_GAS_SN=YOUR_GAS_SERIAL
# OCTO_GAS_COST=10.1 # Your manually configured gas rate in pence/kWh
# VOLUME_CORRECTION=1.02264
# CALORIFIC_VALUE=37.5
# JOULES_CONVERSION=3.6

# Optional export collection: same API key, separate export MPAN.
OCTO_EXPORT_ENABLED=false
# OCTO_EXPORT_ACCOUNT_NUMBER=A-87654321 # Override if export is on a separate account
# OCTO_EXPORT_MPAN=1234567890123 # Export MPAN discovery filter
# OCTO_EXPORT_SN=SN1234567890 # Export serial discovery filter

# Fetch once, print Influx line protocol, and exit without contacting InfluxDB.
DRY_RUN=false
OCTO_TIMEOUT_SECONDS=60 # Per-request timeout; Octopus responses can be slow
