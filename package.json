{
  "name": "octopus-exporter",
  "version": "1.0.0",
  "description": "Collect Octopus Energy import, export and gas readings in InfluxDB",
  "main": "dist/collector.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prestart": "npm run build",
    "start": "node dist/cli.js",
    "predry-run": "npm run build",
    "dry-run": "node dist/cli.js --dry-run",
    "prebackfill": "npm run build",
    "backfill": "node dist/cli.js --backfill"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cimeson/octopus-energy-metrics.git"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "dotenv": "^18.0.9",
    "env-var": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
